# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật vào.
# File ".env" đã được thêm vào .gitignore — KHÔNG commit / chia sẻ file .env thật.

# --- Gemini AI ---
# Lấy key mới tại https://aistudio.google.com/apikey
# QUAN TRỌNG: key cũ từng bị lộ trong code (gemini_service.py) đã bị coi là
# rò rỉ ra ngoài. Hãy vào Google AI Studio thu hồi (revoke/delete) key cũ
# và tạo key mới trước khi deploy.
GEMINI_API_KEY=AQ.Ab8RN6KNwzH7TndwLNQ2LLKHvKawxCYCIbaTBe2c9enQVADcDQ
GEMINI_MODEL=gemini-3.8-flash

# --- Zalo AI TTS ---
# Key cũ trong zalo_service.py cũng đã bị lộ tương tự -> vào Zalo AI Console
# thu hồi và tạo key mới.
ZALO_API_KEY=aL7ESnlFR14bINBe3twyJxmchhMIymGb

# --- JWT ---
# Sinh 1 chuỗi ngẫu nhiên mạnh, ví dụ: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# --- Database ---
# Dev: để mặc định SQLite. Production: trỏ sang Postgres, ví dụ:
# DATABASE_URL=postgresql://user:password@localhost:5432/voice_assistant
DATABASE_URL=sqlite:///./app_voice.db

# --- Dọn file audio tạm ---
FILE_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60


# --- Logging ---
LOG_LEVEL=INFO

# --- Đăng nhập bằng Google ---
# "Web client ID" (OAuth 2.0, loại *Web application*) tạo ở Google Cloud Console >
# APIs & Services > Credentials. Dùng CÙNG giá trị này cho app Flutter:
#   flutter run --dart-define=GOOGLE_SERVER_CLIENT_ID=<giá trị này>
GOOGLE_CLIENT_ID=397099624436-ft12fkdsfafo4jsu0llf91ddkhj0fhdb.apps.googleusercontent.com

# --- Gửi mail mã quên mật khẩu qua Gmail ---
# Gmail KHÔNG cho đăng nhập SMTP bằng mật khẩu thường. Cần:
#   1) Bật Xác minh 2 bước:   https://myaccount.google.com/security
#   2) Tạo Mật khẩu ứng dụng: https://myaccount.google.com/apppasswords
#      (Google hiện 16 ký tự dạng "abcd efgh ijkl mnop" — dán nguyên cũng được)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=phamsihiep97@gmail.com
SMTP_PASSWORD=dyzy bgpm yqft dide
# Để trống = dùng SMTP_USER làm địa chỉ người gửi (khuyến nghị với Gmail).
SMTP_FROM=
RESET_CODE_EXPIRE_MINUTES=10
